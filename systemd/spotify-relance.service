[Unit]
Description=Watchdog de relance raspotify apres perte de session librespot
Documentation=file:/usr/local/share/doc/spotify-relance-runbook.md
After=raspotify.service
# Aucune dependance demarrant raspotify : ce service n'exige ni ne tire
# l'unite surveillee, il l'observe seulement.

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/spotify-relance.sh
# Bornes : un passage court, jamais de second essai automatique.
TimeoutStartSec=90
Nice=10
# Etat borne au boot courant, conserve entre passages du timer,
# efface au redemarrage (tmpfs) : grace et cooldown par boot.
RuntimeDirectory=spotify-relance
RuntimeDirectoryMode=0755
